ENV=development

# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 逗号分隔可放多个，第一个用于加密，其余仅用于解密（轮换）
# 警告：密钥丢失将导致所有历史夜记正文永久不可读，务必另存于密码管理器
FERNET_KEYS=REPLACE_WITH_GENERATED_KEY
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# 本项目的表隔离在独立 schema，不与库中其他项目的 public.users 冲突
DB_SCHEMA=zhusheng

REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=REPLACE

# 无 AppID 时开启，可在微信开发者工具中完整调试；production 下开启会拒绝启动
WX_MOCK_LOGIN=true
WX_APPID=
WX_SECRET=

# 浏览器与小程序【直接】用这个地址取图，所以它必须是对方能访问到的地址。
# 只在本机开发用 http://127.0.0.1:8010/static 就够；
# 要从局域网内别的机器访问后台，填本机局域网 IP，如 http://10.0.0.5:8010/static
# （填 localhost 会让别的机器去找它自己，图片全部裂掉）。
# 上线后改成对象存储或正式域名。
ASSET_BASE_URL=http://127.0.0.1:8010/static
